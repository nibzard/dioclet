# Copy this file to .env and fill in the keys for the providers you use.
# Arena offers only the providers that have keys. Do not commit .env.

# OpenAI Decisions (provider: openai)
OPENAI_API_KEY=

# TypeSafe Jev (provider: jev)
TYPESAFE_API_KEY=

# Cloudflare Clef on Workers AI (provider: clef); both values are necessary
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Perplexity Decider (provider: pplx)
PERPLEXITY_API_KEY=

# Set to 1 to run the live contract tests. These tests spend money.
# ARENA_LIVE_CONTRACT=1
